# copy to .env.production.local (or set in Netlify) before `npm run build`
# (the onyx testnet; left unset, the client plays a local chain)
NEXT_PUBLIC_SITE_URL=https://gnogolf.xyz
NEXT_PUBLIC_REALM=gno.land/r/nym-alexiscolin000/gnogolf/golf
NEXT_PUBLIC_RPC=https://rpc.onyx.testnets.gno.land:443
NEXT_PUBLIC_WEB=https://onyx.testnets.gno.land
# which deployment this is (testnet | mainnet), and the other one's address
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_OTHER_URL=
# 1 lists the community's holes with the cups (off until the builder is out)
NEXT_PUBLIC_COMMUNITY=
# 1 offers a clip of the holing shot in the hole-finished card (ADR-003)
NEXT_PUBLIC_CLIPS=
# optional: anonymous audience measurement (PostHog Cloud EU, docs/analytics.md):
# the project's public write-only key (phc_…); unset, nothing loads or is sent
NEXT_PUBLIC_POSTHOG_KEY=
# optional: the testnet faucet (default https://faucet.gno.land); on mainnet, where to get GNOT (default the same hub)
NEXT_PUBLIC_FAUCET=
NEXT_PUBLIC_GNOT_URL=
