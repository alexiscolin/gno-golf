{
  "name": "gnogolf",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && next build",
    "start": "npx serve out",
    "lint": "eslint --no-error-on-unmatched-pattern . ../media/promo ../media/camera ../media/lib ../media/og ../scripts",
    "selfcheck": "node --experimental-strip-types --disable-warning=ExperimentalWarning ../scripts/selfcheck.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --import ./test/setup.mjs --test --experimental-test-coverage --test-coverage-include='lib/**/*.ts' --test-coverage-exclude='lib/scene/**' --test-coverage-exclude='lib/scene.ts' --test-coverage-exclude='lib/engine.ts' --test-coverage-exclude='lib/promo.ts' --test-coverage-exclude='lib/types.ts' --test-coverage-exclude='lib/engine/types.ts' --test-coverage-exclude='test/**' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=70 test/*.test.ts",
    "check": "sh ../scripts/check.sh",
    "smoke": "node --experimental-strip-types --disable-warning=ExperimentalWarning ../scripts/smoke.ts",
    "og": "node ../media/og/og.mjs"
  },
  "dependencies": {
    "next": "^15.1.6",
    "posthog-js": "^1.434.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.169.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
