// Publishes course holes 8-14 of data/holes.txt, generated by
// scripts/publishdata.sh. Run it as the course's owner.
package main

import "gno.land/r/gnogolf/golf"

func main(cur realm) {
	for _, h := range [][2]string{
		{"garden/6", ""},
		{"garden/7", ""},
		{"garden/8", ""},
		{"garden/9", ""},
		{"garden/10", ""},
		{"garden/11", ""},
		{"garden/12", ""},
	} {
		// the data already current there: nothing to do
		if id := golf.Current(h[0]); id != "" && golf.HoleData(id) == h[1] {
			continue
		}
		println(golf.Publish(cross(cur), h[0], h[1], ""))
	}
}
