// Checks every slot of data/holes.txt against the chain: its current
// version's data has the sha it is listed with. Generated by
// scripts/publishdata.sh; run it simulated.
package main

import (
	"strings"

	"gno.land/r/gnogolf/golf"
)

func main() {
	ok, bad := 0, ""
	for _, h := range [][2]string{
		{"extras/10", "6c123f0a"},
		{"extras/16", "595983ab"},
		{"garden/1", "de9ca2d1"},
		{"garden/2", "53d3dd12"},
		{"garden/3", "f8beb5d2"},
		{"garden/4", "9e42cf8d"},
		{"garden/5", "32aa6462"},
		{"garden/6", "87b5cc53"},
		{"garden/7", "dd7a0625"},
		{"garden/8", "64c89375"},
		{"garden/9", "d97650c5"},
		{"garden/10", "eb763e7b"},
		{"garden/11", "79d10b57"},
		{"garden/12", "2e1afbbb"},
		{"garden/13", "07c002fe"},
		{"garden/14", "23e9c164"},
		{"garden/15", "49320f96"},
		{"garden/16", "dad81a6a"},
		{"garden/17", "9da8fc5b"},
		{"garden/18", "6e50a9d3"},
		{"island/1", "93b51bbf"},
		{"island/2", "1d78a84f"},
		{"island/3", "c613176e"},
		{"island/4", "d5987536"},
		{"island/5", "4b3e604b"},
		{"island/6", "80626325"},
		{"island/7", "15367f7d"},
		{"island/8", "9e2fd904"},
		{"island/9", "b42e8040"},
		{"island/10", "e09471d9"},
		{"island/11", "703e54b3"},
		{"island/12", "b64408ea"},
		{"island/13", "99474d30"},
		{"island/14", "091c0993"},
		{"island/15", "358d9911"},
		{"island/16", "080d6274"},
		{"island/17", "c0f1a2b7"},
		{"island/18", "71a81ca2"},
		{"mountain/1", "c07db472"},
		{"mountain/2", "4eb7759d"},
		{"mountain/3", "fba57ad8"},
		{"mountain/4", "4c03d1de"},
		{"mountain/5", "2d029fc7"},
		{"mountain/6", "9808d7aa"},
		{"mountain/7", "b26f0f53"},
		{"mountain/8", "9150f1c6"},
		{"mountain/9", "aa337d52"},
		{"mountain/10", "3a235aa5"},
		{"mountain/11", "35f0de44"},
		{"mountain/12", "a3431f20"},
		{"mountain/13", "81bd82e3"},
		{"mountain/14", "e1b74d8d"},
		{"mountain/15", "1fb51294"},
		{"mountain/16", "b6a52b23"},
		{"mountain/17", "81f5cebb"},
		{"mountain/18", "ae76ba9c"},
		{"town/1", "7de2b9e8"},
		{"town/2", "f9b07546"},
		{"town/3", "6926ac88"},
		{"town/4", "9735826b"},
		{"town/5", "3073c098"},
		{"town/6", "a02a8eda"},
		{"town/7", "ba5be74d"},
		{"town/8", "82939c31"},
		{"town/9", "c8acb239"},
		{"town/10", "aea6b089"},
		{"town/11", "ac65cf24"},
		{"town/12", "19c4db68"},
		{"town/13", "0e2fdc67"},
		{"town/14", "0c934d84"},
		{"town/15", "488ada9b"},
		{"town/16", "9ddd6312"},
		{"town/17", "7b545758"},
		{"town/18", "c4cc0105"},
	} {
		// the current version's entry in Versions, up to its end
		if id := golf.Current(h[0]); id != "" {
			v := golf.Versions(h[0])
			v = v[strings.Index(v, `"id":"`+id+`"`):]
			if strings.Contains(v[:strings.Index(v, "}")], `"sha":"`+h[1]) {
				ok++
				continue
			}
		}
		bad += " " + h[0]
	}
	println(ok, "slots hold their data; missing or other:", bad)
}
